[Unit]
Description=E-Shelle TCF daily content and audio health check
After=network.target eshelle.service

[Service]
Type=oneshot
User=eshelle
Group=www-data
WorkingDirectory=/home/eshelle/app
EnvironmentFile=/home/eshelle/app/.env
ExecStart=/home/eshelle/app/.venv/bin/python manage.py check_tcf_daily
TimeoutStartSec=120
Nice=10
