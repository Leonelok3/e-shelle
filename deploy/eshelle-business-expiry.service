[Unit]
Description=Retrogradation des fiches business expirees vers le plan Gratuit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=eshelle
WorkingDirectory=/home/eshelle/app
ExecStart=/home/eshelle/app/.venv/bin/python manage.py expire_business_plans
TimeoutStartSec=30m
