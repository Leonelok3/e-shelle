[Unit]
Description=E-Shelle AdGen Studio - reprise des montages
After=network.target eshelle.service

[Service]
Type=oneshot
User=eshelle
Group=www-data
WorkingDirectory=/home/eshelle/app
EnvironmentFile=/home/eshelle/app/.env
ExecStart=/home/eshelle/app/.venv/bin/python manage.py process_studio_renders
TimeoutStartSec=3600
Nice=10
