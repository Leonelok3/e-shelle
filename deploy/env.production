# ============================================================
#  .env  — PRODUCTION   (copier vers /home/eshelle/app/.env)
#  NE JAMAIS committer ce fichier dans Git
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=REMPLACER_PAR_UNE_CLE_DE_50_CARACTERES_ALEATOIRES
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=e-shelle.com,www.e-shelle.com
SIMPLO_PUBLIC_URL=/simplo/
MAPEX_PUBLIC_URL=/edu/
MAPEX_CSRF_TRUSTED_ORIGINS=
ESHELLE_SUBDOMAIN_CSRF_TRUSTED_ORIGINS=
FORMATIONS_PUBLIC_URL=/formations/
BOUTIQUE_PUBLIC_URL=/boutique/
SERVICES_PUBLIC_URL=/services/
MATHS_PUBLIC_URL=/maths/
LANGUES_PUBLIC_URL=/langues/
ANGLAIS_PUBLIC_URL=/anglais/
ALLEMAND_PUBLIC_URL=/allemand/
ITALIEN_PUBLIC_URL=/italien/
PREP_PUBLIC_URL=/prep/
IMMOBILIER_PUBLIC_URL=/immobilier/
AUTO_PUBLIC_URL=/auto/
ANNONCES_PUBLIC_URL=/annonces/
MARKET_PUBLIC_URL=/annonces/
LOVE_PUBLIC_URL=/rencontres/
AGRO_PUBLIC_URL=/agro/
RESTO_PUBLIC_URL=/resto/
NJANGI_PUBLIC_URL=/njangi/
ADGEN_PUBLIC_URL=/pub/
GAZ_PUBLIC_URL=/gaz/
PHARMA_PUBLIC_URL=/pharma/
SANTE_PUBLIC_URL=/sante/
PRESSING_PUBLIC_URL=/pressing/
AI_PUBLIC_URL=/ai/
JOBS_PUBLIC_URL=/jobs/
TRANSPORT_PUBLIC_URL=/transport/
TCHASLUCPAY_PUBLIC_URL=/tchaslucpay/

# --- Base de données PostgreSQL ---
DATABASE_URL=postgres://eshelle_user:MOT_DE_PASSE_DB@localhost:5432/eshelle_db

# --- Simplo ---
SIMPLO_SECRET_KEY=REMPLACER_PAR_UNE_CLE_DE_50_CARACTERES_ALEATOIRES
SIMPLO_DEBUG=False
SIMPLO_ALLOWED_HOSTS=e-shelle.com,www.e-shelle.com,127.0.0.1,localhost
SIMPLO_CSRF_TRUSTED_ORIGINS=https://e-shelle.com,https://www.e-shelle.com
SIMPLO_FORCE_SCRIPT_NAME=/simplo
SIMPLO_STATIC_URL=/simplo/static/
SIMPLO_MEDIA_URL=/simplo/media/
SIMPLO_DATABASE_URL=postgres://eshelle_user:MOT_DE_PASSE_DB@localhost:5432/simplo_db

# --- Tchaslucpay ---
TCHASLUCPAY_SECRET_KEY=REMPLACER_PAR_UNE_CLE_DE_50_CARACTERES_ALEATOIRES
TCHASLUCPAY_DEBUG=False
TCHASLUCPAY_ALLOWED_HOSTS=e-shelle.com,www.e-shelle.com,127.0.0.1,localhost
TCHASLUCPAY_CSRF_TRUSTED_ORIGINS=https://e-shelle.com,https://www.e-shelle.com
TCHASLUCPAY_FORCE_SCRIPT_NAME=/tchaslucpay
TCHASLUCPAY_STATIC_URL=/tchaslucpay/static/
TCHASLUCPAY_MEDIA_URL=/tchaslucpay/media/
TCHASLUCPAY_DATABASE_URL=postgres://eshelle_user:MOT_DE_PASSE_DB@localhost:5432/tchaslucpay_db

# --- IA ---
ANTHROPIC_API_KEY=sk-ant-VOTRE_VRAIE_CLE_ICI
OPENAI_API_KEY=sk-VOTRE_CLE_OPENAI_ICI

# --- WhatsApp Cloud API ---
# Laisser True tant que Meta n'est pas pret. Passer a False uniquement apres test valide.
WHATSAPP_DRY_RUN=True
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=un_secret_webhook_a_definir

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db
DJANGO_LOG_FILE=/var/log/eshelle/django_errors.log

# --- Email SMTP (Gmail ou Mailgun) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@e-shelle.com
EMAIL_HOST_PASSWORD=MOT_DE_PASSE_APPLICATION_GMAIL
DEFAULT_FROM_EMAIL=E-Shelle <contact@e-shelle.com>

# --- Sécurité cookies HTTPS ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=63072000
