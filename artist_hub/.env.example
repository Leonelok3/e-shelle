# ==============================================================================
# ARTIST HUB — VARIABLES D'ENVIRONNEMENT (.env.example)
# Configuration complète pour GROUP OPUS / Fashion Week Douala 2026
# ==============================================================================

# ── IDENTITÉ & MARQUE ──
ARTIST_HUB_ARTIST_NAME="GROUP OPUS"
ARTIST_HUB_BRAND_NAME="OPLUS"
ARTIST_HUB_EVENT_TITLE="Douala Fashion Week 2026"
ARTIST_HUB_EVENT_SUBTITLE="Samedi 26 Décembre 2026 — Hôtel Krystal Palace Douala"
ARTIST_HUB_SLOGAN="Recrutement officiel de mannequins pour la Fashion Week Douala"
ARTIST_HUB_LOGO_URL=""

# ── COULEURS & CHARTE GRAPHIQUE (HEXADÉCIMAL) ──
ARTIST_HUB_PRIMARY_COLOR="#D4AF37"        # Or haute couture
ARTIST_HUB_SECONDARY_COLOR="#0B0C10"      # Noir profond
ARTIST_HUB_ACCENT_COLOR="#E11D48"         # Rouge glamour
ARTIST_HUB_BG_CARD="#14161D"              # Surface cartes sombres

# ── TARIFS & MONNAIE ──
ARTIST_HUB_CURRENCY="XAF"
ARTIST_HUB_FEE_CAMEROON="3000"            # 3 000 FCFA pour le Cameroun
ARTIST_HUB_FEE_INTERNATIONAL="5000"       # 5 000 FCFA pour l'international

# ── COORDONNÉES OFFICIELLES DE PAIEMENT & CONTACT ──
ARTIST_HUB_ORANGE_MONEY="+237 695 487 796"
ARTIST_HUB_MTN_MOMO="+237 675 293 836"
ARTIST_HUB_ECOBANK_RIB="4020789949967166"
ARTIST_HUB_CONTACT_WHATSAPP="+237675293836"
ARTIST_HUB_CONTACT_EMAIL="oplusproduction9@gmail.com"

# ── FOURNISSEUR DE PAIEMENT ACTIF ──
# Options : 'manual_proof' (recommandé pour MoMo direct + preuve), 'mock' (dev local), 'notchpay', 'cinetpay'
ARTIST_HUB_PAYMENT_PROVIDER="mock"

# ── CLÉS API NOTCH PAY (si activé pour paiement carte/momo en ligne) ──
NOTCHPAY_PUBLIC_KEY="pk.test_xxxxxxxxxxxxxxxxx"
NOTCHPAY_PRIVATE_KEY="sk.test_xxxxxxxxxxxxxxxxx"
NOTCHPAY_HASH_KEY="whsec_xxxxxxxxxxxxxxxxx"
NOTCHPAY_BASE_URL="https://api.notchpay.co"

# ── PARAMÈTRES TECHNIQUES & SÉCURITÉ ──
ARTIST_HUB_MAX_UPLOAD_MB="5"
ARTIST_HUB_MAX_PHOTOS="4"
ARTIST_HUB_MIN_HEIGHT_MALE="183"
ARTIST_HUB_MIN_HEIGHT_FEMALE="175"
