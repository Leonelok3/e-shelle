[Unit]
Description=E-Shelle WhatsApp Immo Group Listener (Baileys)
After=network.target

[Service]
Type=simple
User=eshelle
WorkingDirectory=/home/eshelle/app/immobilier_cameroun/worker_whatsapp_listener
ExecStart=/usr/bin/node listener.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
